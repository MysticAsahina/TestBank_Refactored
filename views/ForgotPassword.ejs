<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - College of Engineering</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(50deg, #ffb649 0%, #ae0000 100%);
            background-attachment: fixed;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-y: auto;
            overflow-x: hidden;
            margin: 0;
            padding: 40px 0;
        }
        label, p {
            color: #fff;
        }
        .card-body.p-4 {
            padding: 0 5rem 3rem 5rem !important;
        }
        .logo-bg {
            position: absolute;
            right: -500px;
            width: 1200px;
            height: 1200px;
            opacity: 0.25;
            z-index: -1000;
            animation: fadeFromRight 3s ease forwards;
        }
        @keyframes fadeFromRight {
            0% {
                opacity: 0;
                transform: translateX(100px);
            }
            100% {
                opacity: 0.25;
                transform: translateX(0);
            }
        }
        .login-card {
            background: rgba(255, 255, 255, 0);
            border-radius: 20px;
            box-shadow:
                5px 5px 10px 5px rgba(0, 0, 0, 0.1),
                inset 3px 3px 20px 0px rgba(255, 255, 255, 0.5);
            overflow: hidden;
            animation: fadeFromBottom 1.5s ease forwards;
            opacity: 0;
            width: 100%;
            
            /* Glare effect variables */
            --gh-width: 100%;
            --gh-height: 100%;
            --gh-bg: transparent;
            --gh-br: 100px;
            --gh-border: transparent;
            --gh-angle: 135deg;
            --gh-rgba: rgba(255, 255, 255, 0.4);
            --gh-duration: 0.6s;
            --gh-size: 200%;
            
            position: relative;
        }
        .login-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                var(--gh-angle),
                transparent 40%,
                var(--gh-rgba) 50%,
                transparent 60%
            );
            transition: var(--gh-duration) ease;
            background-size: 300% 300%;
            background-repeat: no-repeat;
            background-position: -100% -100%;
            border-radius: inherit;
            pointer-events: none;
        }
        .login-card:hover::before {
            background-position: 100% 100%;
        }
        .col-md-6 {
            width: 800px !important;
        }
        @keyframes fadeFromBottom {
            0% {
                opacity: 0;
                transform: translateY(80px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .login-header {
            display: flex;
            flex-direction: column;
            color: white;
            padding: 30px;
            text-align: center;
        }
        .login-header h2 {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 0;
        }
        .login-header p {
            font-size: .8rem;
        }
        .login-header img {
            height: calc(7em + 50px);
            width: calc(7em + 50px);
            object-fit: cover;
            object-position: center;
            align-self: center;
        }
        .role-badge {
            font-size: 0.8em;
            padding: 4px 12px;
            border-radius: 20px;
        }
        .form-control:focus {
            border-color: #ea6666;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .btn-login {
            background: #890000;
            border: none;
            padding: 12px;
            font-weight: 600;
        }
        .btn-login:hover {
            color: #fff !important;
            background-color: #ff5b5b;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(178, 0, 0, 0.4);
        }
        .text-decoration-none {
            color: #ffffff;
        }
        .text-center.mb-3 a {
            display: block;
            text-align: right;
        }
        .text-center.mb-3 a:hover,
        .text-decoration-none.fw-bold:hover {
            text-decoration: underline !important;
        }
        /* Password toggle styles */
        .password-input-container {
            position: relative;
        }
        .password-toggle {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #6c757d;
            cursor: pointer;
            z-index: 10;
        }
        .password-toggle:hover {
            color: #495057;
        }
        .password-toggle:focus {
            outline: none;
            box-shadow: none;
        }
        /* Responsive adjustments */
        @media (max-width: 768px) {
            .card-body.p-4 {
                padding: 0 2rem 2rem 2rem !important;
            }
            .col-md-6 {
                width: 100% !important;
            }
        }
    </style>
</head>
<body>
    <img src="./images/COE_Logo.png" alt="Logo" class="logo-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-card">
                    <div class="login-header">
                        <img src="/images/COE_Logo.png" alt="PHINMA Logo" class="me-2">
                        <h2>College of Engineering</h2>
                        <p class="mb-0">Reset Password</p>
                    </div>
                    
                    <div class="card-body p-4">
                        <!-- Error Message -->
                        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="display: none;">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span id="error-message"></span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                        <!-- Success Message -->
                        <div class="alert alert-success alert-dismissible fade show" role="alert" style="display: none;">
                            <i class="fas fa-check-circle me-2"></i>
                            <span id="success-message"></span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                        
                        <!-- Email Form -->
                        <form id="emailForm" action="/auth/forgot-password" method="POST">
                            <div class="mb-3">
                                <label for="email" class="form-label">
                                    <i class="fas fa-envelope me-2"></i>Email Address
                                </label>
                                <input type="email" class="form-control" id="email" name="email" 
                                       placeholder="Enter your registered email" required>
                                <div class="form-text text-light">
                                    We'll send an OTP to your email to reset your password.
                                </div>
                            </div>
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-login text-white">
                                    <i class="fas fa-paper-plane me-2"></i>Send OTP
                                </button>
                            </div>
                        </form>

                        <!-- OTP and New Password Form (initially hidden) -->
                        <form id="resetForm" action="/auth/reset-password" method="POST" style="display: none;">
                            <input type="hidden" name="email" id="hiddenEmail">
                            
                            <div class="mb-3">
                                <label for="otp" class="form-label">
                                    <i class="fas fa-key me-2"></i>OTP Code
                                </label>
                                <input type="text" class="form-control" id="otp" name="otp" 
                                       placeholder="Enter 6-digit OTP" maxlength="6" required>
                            </div>

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">
                                    <i class="fas fa-lock me-2"></i>New Password
                                </label>
                                <div class="password-input-container">
                                    <input type="password" class="form-control" id="newPassword" name="newPassword" 
                                           placeholder="Enter new password" minlength="6" required>
                                    <button type="button" class="password-toggle" id="toggleNewPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label">
                                    <i class="fas fa-lock me-2"></i>Confirm New Password
                                </label>
                                <div class="password-input-container">
                                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" 
                                           placeholder="Confirm new password" required>
                                    <button type="button" class="password-toggle" id="toggleConfirmPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-login text-white">
                                    <i class="fas fa-save me-2"></i>Reset Password
                                </button>
                            </div>
                        </form>

                        <div class="text-center">
                            <a href="/login" class="text-decoration-none">
                                <i class="fas fa-arrow-left me-1"></i>Back to Login
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Form submission handling
        document.getElementById('emailForm').addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Sending OTP...';
            submitBtn.disabled = true;
            
            // Simulate API call - in a real app, this would be an actual form submission
            setTimeout(() => {
                // Show success message
                showSuccess("OTP sent to your email!");
                
                // Hide email form and show reset form
                document.getElementById('emailForm').style.display = 'none';
                document.getElementById('resetForm').style.display = 'block';
                document.getElementById('hiddenEmail').value = document.getElementById('email').value;
                
                // Reset button state
                submitBtn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Send OTP';
                submitBtn.disabled = false;
            }, 1500);
            
            e.preventDefault(); // Remove this in production
        });

        document.getElementById('resetForm').addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('button[type="submit"]');
            const password = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            
            // Validate passwords match
            if (password !== confirmPassword) {
                e.preventDefault();
                showError("Passwords do not match!");
                return;
            }
            
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Resetting Password...';
            submitBtn.disabled = true;
            
            // Simulate API call - in a real app, this would be an actual form submission
            setTimeout(() => {
                showSuccess("Password reset successfully!");
                // Redirect to login page after successful reset
                setTimeout(() => {
                    window.location.href = '/login';
                }, 2000);
            }, 1500);
            
            e.preventDefault(); // Remove this in production
        });

        // Password toggle functionality
        document.getElementById('toggleNewPassword').addEventListener('click', function() {
            const passwordInput = document.getElementById('newPassword');
            const icon = this.querySelector('i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });

        document.getElementById('toggleConfirmPassword').addEventListener('click', function() {
            const passwordInput = document.getElementById('confirmPassword');
            const icon = this.querySelector('i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });

        // Function to show error message
        function showError(message) {
            const errorAlert = document.querySelector('.alert-danger');
            const errorMessage = document.getElementById('error-message');
            const successAlert = document.querySelector('.alert-success');
            
            errorMessage.textContent = message;
            errorAlert.style.display = 'block';
            successAlert.style.display = 'none';
        }

        // Function to show success message
        function showSuccess(message) {
            const successAlert = document.querySelector('.alert-success');
            const successMessage = document.getElementById('success-message');
            const errorAlert = document.querySelector('.alert-danger');
            
            successMessage.textContent = message;
            successAlert.style.display = 'block';
            errorAlert.style.display = 'none';
        }
    </script>
</body>
</html>