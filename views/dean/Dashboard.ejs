            </div>
            <div class="logout-modal-body">
                <p>Are you sure you want to logout?</p>
            </div>
            <div class="logout-modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelLogout">Cancel</button>
                <form action="/auth/logout" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-danger" id="confirmLogout">Yes, Logout</button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Logout functionality
            const logoutBtn = document.getElementById('logoutBtn');
            const logoutModal = document.getElementById('logoutModal');
            const cancelLogout = document.getElementById('cancelLogout');
            const confirmLogout = document.getElementById('confirmLogout');

            logoutBtn.addEventListener('click', function(e) {
                e.preventDefault();
                logoutModal.style.display = 'block';
            });

            cancelLogout.addEventListener('click', function() {
                logoutModal.style.display = 'none';
            });

            confirmLogout.addEventListener('click', function() {
                // Clear session and prevent back button access
                fetch('/auth/logout', { 
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    }
                }).then(() => {
                    // Clear any cached data
                    if (window.caches) {
                        caches.keys().then(function(names) {
                            for (let name of names) {
                                caches.delete(name);
                            }
                        });
                    }
                    
                    // Redirect to login page
                    window.location.href = '/login';
                    
                    // Prevent back navigation
                    window.history.pushState(null, null, window.location.href);
                    window.onpopstate = function() {
                        window.history.go(1);
                    };
                });
            });

            // Close modal when clicking outside
            window.addEventListener('click', function(e) {
                if (e.target === logoutModal) {
                    logoutModal.style.display = 'none';
                }
            });

            // Global variables
            let allCharts = {};
            let currentFilters = {};
            let currentPeriodFilter = 'all';

            // Initialize dashboard when DOM is loaded
            initializeDashboard();
            setupEventListeners();

            // Main initialization function
            async function initializeDashboard() {
                console.log("🚀 Initializing period-based dashboard...");
                document.getElementById('loadingSpinner').style.display = 'block';

                try {
                    // Load available periods and initial data
                    await loadAvailablePeriods();
                    await loadPeriodData('all');
                    
                    showNotification('Period-based dashboard loaded successfully!', 'success');
                } catch (error) {
                    console.error('❌ Dashboard initialization error:', error);
                    showNotification('Failed to load dashboard: ' + error.message, 'danger');
                } finally {
                    document.getElementById('loadingSpinner').style.display = 'none';
                }
            }

            // Consolidated data loading function
            async function fetchData(endpoint, filters = {}) {
                const params = new URLSearchParams(filters);
                const response = await fetch(`/api/dashboard/${endpoint}?${params}`);
                if (!response.ok) throw new Error(`Failed to load ${endpoint} data`);
                return await response.json();
            }

            // Unified data loading functions
            async function loadOverviewData(filters = {}) {
                return fetchData('overview', filters);
            }

            async function loadPerformanceTrendData(filters = {}) {
                return fetchData('performance-trend', filters);
            }

            async function loadCourseDifficultyData(filters = {}) {
                return fetchData('course-difficulty', filters);
            }

            async function loadStudentAnalyticsData(filters = {}) {
                return fetchData('student-analytics', filters);
            }

            async function loadProfessorAnalyticsData(filters = {}) {
                return fetchData('professor-analytics', filters);
            }

            async function loadSectionAnalyticsData(filters = {}) {
                return fetchData('section-analytics', filters);
            }

            async function loadLearningCurveData(filters) {
                try {
                    const response = await fetch(`/api/dashboard/learning-curve?period=${filters.period}`);
                    if (!response.ok) throw new Error('Failed to load Learning Curve data');
                    const data = await response.json();
                    console.log('📊 Learning Curve Data:', data);
                    return data;
                } catch (error) {
                    console.error('Error loading Learning Curve data:', error);
                    return { labels: [], data: [] };
                }
            }

            // Period-based data loading
            async function loadPeriodData(period) {
                const filters = { period };
                
                const [
                    overviewData,
                    trendData,
                    difficultyData,
                    learningCurveData,
                    studentData,
                    professorData,
                    sectionData
                ] = await Promise.all([
                    loadOverviewData(filters),
                    loadPerformanceTrendData(filters),
                    loadCourseDifficultyData(filters),
                    loadLearningCurveData(filters),
                    loadStudentAnalyticsData(filters),
                    loadProfessorAnalyticsData(filters),
                    loadSectionAnalyticsData(filters)
                ]);


                // Update all dashboard components
                updateOverviewCards(overviewData);
                initializePerformanceTrendChart(trendData);
                initializeCourseDifficultyChart(difficultyData);
                initializeLearningCurveChart(learningCurveData);
                initializeStudentAnalytics(studentData);
                initializeProfessorAnalytics(professorData);
                updateSectionAnalytics(sectionData);

                function updateSectionAnalytics(data) {
                    document.getElementById('totalSections').textContent = data.kpis.totalSections;
                    document.getElementById('topSection').textContent = data.kpis.topSection;
                    document.getElementById('averageScore').textContent = `${data.kpis.averageScore}%`;
                    document.getElementById('passingRate').textContent = `${data.kpis.passingRate}%`;
                    document.getElementById('totalTests').textContent = data.kpis.totalTests;
                }
            }

            // Chart initialization functions
            function initializePerformanceTrendChart(data) {
                createLineChart('performanceTrendChart', {
                    label: 'Average Score (%)',
                    data: data.data,
                    labels: data.labels,
                    borderColor: 'rgba(54, 162, 235, 1)',
                    backgroundColor: 'rgba(54, 162, 235, 0.1)',
                    showRegression: true,
                    regressionLabel: `Trend Line (R² = ${data.correlation})`
                });
            }

            function initializeCourseDifficultyChart(data) {
                createBarChart('courseDifficultyChart', {
                    label: 'Average Score (%)',
                    data: data.data,
                    labels: data.labels,
                    backgroundColor: [
                        'rgba(75, 192, 192, 0.8)',
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(255, 159, 64, 0.8)',
                        'rgba(153, 102, 255, 0.8)',
                        'rgba(255, 99, 132, 0.8)'
                    ]
                });
            }

            function initializeLearningCurveChart(data) {
                console.log("📊 Learning Curve Data:", data);

                createLineChart('learningCurveChart', {
                    label: 'Average Score',
                    data: data.data,
                    labels: data.labels,
                    borderColor: 'rgba(255, 159, 64, 1)',
                    backgroundColor: 'rgba(255, 159, 64, 0.1)',
                    showRegression: true,
                    regressionLabel: 'Learning Trend'
                });
            }


            // Student analytics
            async function initializeStudentAnalytics(data) {
                initializeStudentPerformanceChart(data);
                initializePassingRateChart(data);
            }

            function initializeStudentPerformanceChart(data) {
                createLineChart('studentPerformanceChart', {
                    label: 'Weekly Average',
                    data: data.data,
                    labels: data.labels,
                    borderColor: 'rgba(54, 162, 235, 1)',
                    backgroundColor: 'rgba(54, 162, 235, 0.1)',
                    showRegression: true,
                    regressionLabel: 'Performance Trend'
                });
            }

            function initializePassingRateChart(data) {
                const passingData = data.data.map(score => score >= 75 ? 100 : 50);
                
                createLineChart('passingRateChart', {
                    label: 'Passing Rate (%)',
                    data: passingData,
                    labels: data.labels,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    showRegression: true,
                    regressionLabel: 'Improvement Trend',
                    yMin: 0,
                    yMax: 100
                });
            }

            // Professor analytics
            async function initializeProfessorAnalytics(data) {
                initializeProfessorEffectivenessChart(data);
                initializeTestCreationChart(data);
            }

            function initializeProfessorEffectivenessChart(data) {
                const effectivenessData = data.map(prof => prof.effectiveness);
                const labels = data.map(prof => prof.name.split(' ')[0]);
                
                createLineChart('professorEffectivenessChart', {
                    label: 'Student Performance (%)',
                    data: effectivenessData,
                    labels: labels,
                    borderColor: 'rgba(153, 102, 255, 1)',
                    backgroundColor: 'rgba(153, 102, 255, 0.1)',
                    showRegression: true,
                    regressionLabel: 'Effectiveness Trend'
                });
            }

            function initializeTestCreationChart(data) {
                const testData = data.map(prof => prof.testsCreated);
                const labels = data.map(prof => prof.name.split(' ')[0]);
                
                createLineChart('testCreationChart', {
                    label: 'Tests Created',
                    data: testData,
                    labels: labels,
                    borderColor: 'rgba(255, 159, 64, 1)',
                    backgroundColor: 'rgba(255, 159, 64, 0.1)',
                    showRegression: true,
                    regressionLabel: 'Activity Trend',
                    yBeginAtZero: true
                });
            }

            // Department analytics
            function initializeCompletionRateChart(data) {
                const completionData = data.data.map(score => Math.min(100, score + 10));
                
                createLineChart('completionRateChart', {
                    label: 'Completion Rate (%)',
                    data: completionData,
                    labels: data.labels,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    showRegression: true,
                    regressionLabel: 'Improvement Trend',
                    yMin: 80,
                    yMax: 100
                });
            }

            // Reusable chart creation functions
            function createLineChart(canvasId, config) {
                const ctx = document.getElementById(canvasId)?.getContext('2d');
                if (!ctx) return;

                // Destroy existing chart
                if (allCharts[canvasId]) {
                    allCharts[canvasId].destroy();
                }

                const datasets = [{
                    label: config.label,
                    data: config.data,
                    borderColor: config.borderColor,
                    backgroundColor: config.backgroundColor,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4
                }];

                if (config.showRegression) {
                    datasets.push({
                        label: config.regressionLabel,
                        data: calculateLinearRegression(config.data),
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 2,
                        borderDash: [5, 5],
                        fill: false,
                        pointRadius: 0
                    });
                }

                allCharts[canvasId] = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: config.labels,
                        datasets: datasets
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: config.yBeginAtZero || false,
                                min: config.yMin !== undefined ? config.yMin : Math.min(...config.data) - 5,
                                max: config.yMax !== undefined ? config.yMax : Math.max(...config.data) + 5,
                                title: {
                                    display: true,
                                    text: config.label
                                }
                            }
                        }
                    }
                });
            }

            function createBarChart(canvasId, config) {
                const ctx = document.getElementById(canvasId)?.getContext('2d');
                if (!ctx) return;

                if (allCharts[canvasId]) {
                    allCharts[canvasId].destroy();
                }

                allCharts[canvasId] = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: config.labels,
                        datasets: [{
                            label: config.label,
                            data: config.data,
                            backgroundColor: config.backgroundColor
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                title: {
                                    display: true,
                                    text: config.label
                                }
                            }
                        }
                    }
                });
            }

            // Section analytics
            async function updateSectionAnalytics(data) {
                populateSectionTables(data);
            }

            function populateSectionTables(data) {
                populateAvgScoreTable(data);
                populateLowestScoreTable(data);
                populateHighestScoreTable(data);
                populateTopStudentTable(data);
                populateLowestStudentTable(data);
            }

            function populateAvgScoreTable(data) {
                populateTable('#avgScoreTable tbody', data, section => `
                    <tr>
                        <td>${section.section}</td>
                        <td>${section.course}</td>
                        <td>${section.yearLevel}</td>
                        <td>${section.avgScore}%</td>
                        <td><span class="text-${section.trend === 'up' ? 'success' : 'danger'}">
                            <i class="fas fa-arrow-${section.trend}"></i> ${section.trendValue}%
                        </span></td>
                    </tr>
                `);
            }

            function populateLowestScoreTable(data) {
                populateTable('#lowestScoreTable tbody', data, section => `
                    <tr>
                        <td>${section.section}</td>
                        <td>${section.course}</td>
                        <td>${section.yearLevel}</td>
                        <td>${section.lowestScore}%</td>
                        <td>${Math.round((75 - section.lowestScore) * 10) / 10}%</td>
                    </tr>
                `);
            }

            function populateHighestScoreTable(data) {
                populateTable('#highestScoreTable tbody', data, section => `
                    <tr>
                        <td>${section.section}</td>
                        <td>${section.course}</td>
                        <td>${section.yearLevel}</td>
                        <td>${section.highestScore}%</td>
                        <td>${section.course} Core Subject</td>
                    </tr>
                `);
            }

            function populateTopStudentTable(data) {
                populateTable('#topStudentTable tbody', data, (section, index) => `
                    <tr>
                        <td>${section.section}</td>
                        <td>Top Student ${index + 1}</td>
                        <td>2023-00${1000 + index}</td>
                        <td>${Math.round(section.highestScore * 10) / 10}%</td>
                        <td><span class="badge bg-success">Excellent</span></td>
                    </tr>
                `);
            }

            function populateLowestStudentTable(data) {
                populateTable('#lowestStudentTable tbody', data, (section, index) => {
                    const intervention = section.lowestScore > 70 ? 'Low' : section.lowestScore > 60 ? 'Moderate' : 'High';
                    const badgeClass = intervention === 'High' ? 'danger' : intervention === 'Moderate' ? 'warning' : 'success';
                    
                    return `
                    <tr>
                        <td>${section.section}</td>
                        <td>Student ${index + 1}</td>
                        <td>2023-00${2000 + index}</td>
                        <td>${Math.round(section.lowestScore * 10) / 10}%</td>
                        <td><span class="badge bg-${badgeClass}">${intervention}</span></td>
                    </tr>
                `});
            }

            function populateTable(selector, data, rowTemplate) {
                const tbody = document.querySelector(selector);
                if (!tbody) return;
                
                tbody.innerHTML = data.map((item, index) => rowTemplate(item, index)).join('');
            }

            // Update overview cards
            function updateOverviewCards(data) {
                document.getElementById('totalProfessors').textContent = data.totalProfessors;
                document.getElementById('totalStudents').textContent = data.totalStudents;
                document.getElementById('totalTests').textContent = data.totalTests;
                document.getElementById('overallPassRate').textContent = `${data.overallPassRate}%`;
                document.getElementById('avgScore').textContent = `${data.avgScore}%`;
                document.getElementById('completionRate').textContent = `${data.completionRate}%`;
            }

            // Period filter functionality
            async function applyPeriodFilter() {
                const periodFilter = document.getElementById('semesterPeriodFilter').value;
                currentPeriodFilter = periodFilter;
                
                console.log("🔄 Applying period filter:", periodFilter);
                document.getElementById('loadingSpinner').style.display = 'block';
                
                try {
                    await loadPeriodData(periodFilter);
                    
                    // Update period display
                    const periodDisplay = document.getElementById('currentPeriodDisplay');
                    const selectedOption = document.getElementById('semesterPeriodFilter').selectedOptions[0];
                    periodDisplay.textContent = selectedOption.textContent;
                    
                    showNotification(`Showing data for ${selectedOption.textContent}`, 'success');
                } catch (error) {
                    console.error('❌ Period filter error:', error);
                    showNotification('Failed to apply period filter: ' + error.message, 'danger');
                } finally {
                    document.getElementById('loadingSpinner').style.display = 'none';
                }
            }

            async function loadAvailablePeriods() {
                try {
                    const response = await fetch('/api/dashboard/available-periods');
                    if (response.ok) {
                        const periods = await response.json();
                        updatePeriodFilterDropdown(periods);
                    }
                } catch (error) {
                    console.error('Error loading available periods:', error);
                }
            }

            function updatePeriodFilterDropdown(periods) {
                const filterSelect = document.getElementById('semesterPeriodFilter');
                if (!filterSelect) return;
                
                filterSelect.innerHTML = '<option value="all">All Periods</option>';
                
                if (periods && periods.length > 0) {
                    periods.forEach(period => {
                        if (period) {
                            const option = document.createElement('option');
                            option.value = period.toLowerCase().replace(/\s+/g, '-');
                            option.textContent = period;
                            filterSelect.appendChild(option);
                        }
                    });
                }
            }

            
            // Filter application functions
            async function applyChartFilters(chartType) {
                showNotification(`Applying filters to ${chartType.replace(/([A-Z])/g, ' $1').toLowerCase()} chart...`, 'info');
                
                try {
                    const filters = getCurrentFilters(chartType);
                    filters.period = currentPeriodFilter;
                    
                    let newData;
                    switch(chartType) {
                        case 'performanceTrend':
                            newData = await loadPerformanceTrendData(filters);
                            initializePerformanceTrendChart(newData);
                            break;
                        case 'courseDifficulty':
                            newData = await loadCourseDifficultyData(filters);
                            initializeCourseDifficultyChart(newData);
                            break;
                        case 'studentPerformance':
